<Window x:Class="FocusGarden.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="专注花园 · Focus Garden" Width="1120" Height="790" MinWidth="960" MinHeight="680" WindowStartupLocation="CenterScreen">
 <Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Grid.Column="0" Margin="0,8,24,0">
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="◉" FontSize="34" Foreground="{StaticResource Green}"/><TextBlock Text="专注花园" FontSize="23" FontWeight="Bold" Margin="0,8,0,3"/><TextBlock Text="FOCUS GARDEN" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,36"/><Button Content="◷   开始专注" Click="ShowFocus" Margin="0,0,0,10" HorizontalContentAlignment="Left"/><Button Content="▦   专注统计" Click="ShowStats" Margin="0,0,0,10"/><Button Content="☷   使用限制" Click="ShowRules" Margin="0,0,0,10"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="一点一滴，积累专注。" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="本机保存 · 无需登录" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,8"/><TextBlock Text="MVP 0.1" Foreground="#637A7D" FontSize="11"/></StackPanel>
  </DockPanel>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,4,0,24"><TextBlock x:Name="PageTitle" Text="把这一刻，留给重要的事。" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="选一件小事，开始一段完整的专注。" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,12,0">
     <StackPanel x:Name="FocusPage">
      <Border Background="{StaticResource Card}" CornerRadius="16" Padding="28,20"><StackPanel>
       <TextBlock x:Name="SessionLabel" Text="准备好，从一个番茄开始" Foreground="{StaticResource Green}" HorizontalAlignment="Center" FontSize="14"/>
       <TextBlock x:Name="TimerText" Text="25:00" FontFamily="Consolas" FontSize="86" HorizontalAlignment="Center" Margin="0,12,0,4"/>
       <ProgressBar x:Name="TimerProgress" Height="4" Maximum="1" Foreground="{StaticResource Green}" Background="#293C40" BorderThickness="0" Margin="50,0,50,22"/>
       <TextBlock Text="这次想完成什么？" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
       <TextBox x:Name="TaskInput" Text="" MaxLength="120" ToolTip="例如：读完一节教材，整理三条笔记"/>
       <StackPanel x:Name="SetupPanel" Margin="0,17,0,0">
        <StackPanel Orientation="Horizontal"><TextBlock Text="专注" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="FocusMinutesInput" Text="25" Width="60" MaxLength="3"/><TextBlock Text="分钟" VerticalAlignment="Center" Margin="8,0,24,0"/><TextBlock Text="休息" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="BreakMinutesInput" Text="5" Width="60" MaxLength="2"/><TextBlock Text="分钟" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
        <CheckBox x:Name="ImmersiveCheck" Content="全屏沉浸（当前屏幕）；取消勾选使用工作模式" IsChecked="True"/>
       </StackPanel>
       <WrapPanel Margin="0,17,0,0"><Button x:Name="StartButton" Content="开始专注  →" Style="{StaticResource Primary}" Click="StartFocus"/><Button x:Name="EmergencyButton" Content="紧急退出" Click="EmergencyClick" Visibility="Collapsed"/><Button x:Name="FullscreenButton" Content="进入全屏" Click="EnterFullscreenClick" Visibility="Collapsed"/><Button x:Name="BreakButton" Content="休息一下" Click="StartBreak"/><Button x:Name="TestButton" Content="10 秒验收" Click="StartTest" Visibility="Collapsed"/></WrapPanel>
      </StackPanel></Border>
      <Border BorderBrush="#2C4045" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,18,0,0"><StackPanel><TextBlock Text="给专注留边界，也给自己留出口。" FontWeight="SemiBold"/><TextBlock Text="所选应用会被最小化，文档与进程仍保留。网站扩展仅拦截新访问。全屏和限制均可由紧急退出解除。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/><TextBlock x:Name="HotkeyHint" Text="紧急快捷键：Ctrl + Alt + Esc" Foreground="{StaticResource Green}" Margin="0,8,0,0" FontSize="12"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="StatsPage" Visibility="Collapsed">
      <UniformGrid Columns="3" Margin="0,0,0,20"><Border Background="{StaticResource Card}" CornerRadius="12" Margin="0,0,10,0" Padding="18"><StackPanel><TextBlock Text="今日专注" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TodayStat" Text="0 分钟" FontSize="27" Margin="0,10,0,0"/></StackPanel></Border><Border Background="{StaticResource Card}" CornerRadius="12" Margin="0,0,10,0" Padding="18"><StackPanel><TextBlock Text="所选年完成番茄" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CompletedStat" Text="0" FontSize="27" Margin="0,10,0,0"/></StackPanel></Border><Border Background="{StaticResource Card}" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="所选年专注天数" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DaysStat" Text="0 天" FontSize="27" Margin="0,10,0,0"/></StackPanel></Border></UniformGrid>
      <Border Background="{StaticResource Card}" CornerRadius="14" Padding="20"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" Padding="10,4" Click="PreviousYear"/><TextBlock x:Name="YearLabel" VerticalAlignment="Center"/><Button Content="›" Padding="10,4" Margin="10,0,0,0" Click="NextYear"/></StackPanel><TextBlock Text="让专注，慢慢生长" FontSize="18" FontWeight="SemiBold"/></DockPanel><TextBlock x:Name="YearSummary" Foreground="{StaticResource Muted}" Margin="0,8,0,12"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><Grid x:Name="Heatmap" Height="154"/></ScrollViewer><TextBlock Text="浅 → 深：0 / &lt;25 / 25–49 / 50–99 / ≥100 分钟；悬停查看具体日期。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/><TextBlock Text="热力图累计实际记录时长，包含提前结束的专注；休息不计入。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
      <DockPanel Margin="0,22,0,12"><Button Content="导出 CSV" DockPanel.Dock="Right" Click="ExportCsv" Padding="14,7"/><TextBlock Text="最近的专注记录" FontSize="18" VerticalAlignment="Center"/></DockPanel>
      <StackPanel x:Name="HistoryPanel"/>
     </StackPanel>
     <StackPanel x:Name="RulesPage" Visibility="Collapsed">
      <Border Background="{StaticResource Card}" CornerRadius="14" Padding="24"><StackPanel>
       <TextBlock Text="应用限制" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="每行一个进程名，例如 notepad.exe。专注时切换到它会被最小化；不会关闭文件。" Foreground="{StaticResource Muted}" Margin="0,8,0,12" FontSize="12"/>
       <TextBox x:Name="AppsInput" Height="84" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
       <WrapPanel Margin="0,10,0,18"><ComboBox x:Name="RunningApps" Width="230" Margin="0,0,10,0"/><Button Content="刷新运行列表" Click="RefreshApps" Padding="12,7"/><Button Content="加入列表" Click="AddApp" Padding="12,7"/></WrapPanel>
       <TextBlock Text="网站新访问限制" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="每行一个域名，例如 bilibili.com；包含子域。需要下方浏览器扩展，已打开的页面不会自动关闭或停止播放。" Foreground="{StaticResource Muted}" Margin="0,8,0,12" FontSize="12"/>
       <TextBox x:Name="DomainsInput" Height="84" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
       <Button Content="保存限制设置" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="SaveRules" Margin="0,16,0,0"/>
      </StackPanel></Border>
      <Border BorderBrush="#2C4045" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,18,0,0"><StackPanel><TextBlock Text="连接 Edge / Chrome 扩展" FontSize="18"/><TextBlock Text="在浏览器扩展页加载交付包内的 browser-extension 文件夹，然后在扩展弹窗粘贴配对码。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12"/><WrapPanel><Button Content="复制配对码" Click="CopyToken" Padding="14,8"/><Button Content="打开扩展文件夹" Click="OpenExtensionFolder" Padding="14,8"/></WrapPanel><TextBlock x:Name="ApiStatus" Foreground="{StaticResource Green}" FontSize="12" Margin="0,12,0,0"/><TextBlock Text="桌面退出或断联后，扩展在下次唤醒同步时解除；若浏览器挂起，可禁用扩展立即恢复。应用限制无法拦截管理员窗口或改名后的程序。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <TextBlock Grid.Row="2" x:Name="StatusText" Text="就绪 · 所有记录仅保存在本机" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/>
  </Grid>
 </Grid>
</Window>

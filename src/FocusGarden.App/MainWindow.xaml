<Window x:Class="FocusGarden.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" Title="专注星球 0.7.2 · Focus Planet" Width="1380" Height="1040" MinWidth="960" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Grid Margin="24" TextElement.Foreground="{StaticResource Text}"><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Grid.Column="0" Margin="0,8,24,0">
   <StackPanel DockPanel.Dock="Top"><Image Source="Assets/FocusPlanet-256.png" Width="48" Height="48" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="专注星球" FontSize="23" FontWeight="Bold" Margin="0,8,0,3"/><TextBlock Text="FOCUS PLANET" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,36"/><Button Content="◉   我的星球" Click="ShowPlanet" Margin="0,0,0,10" HorizontalContentAlignment="Left"/><Button Content="◷   开始专注" Click="ShowFocus" Margin="0,0,0,10" HorizontalContentAlignment="Left"/><Button Content="◴   应用时长" Click="JumpToUsage" Margin="0,0,0,10"/><Button Content="◈   Token 日历" Click="JumpToTokens" Margin="0,0,0,10"/><Button Content="▦   专注统计" Click="ShowStats" Margin="0,0,0,10"/><Button Content="☷   使用限制" Click="ShowRules" Margin="0,0,0,10"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><TextBlock Text="一点投入，一个世界。" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="本机保存 · 无需登录" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,8"/><TextBlock Text="MVP 0.7.2" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
  </DockPanel>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,4,0,20"><TextBlock x:Name="PageTitle" Text="把这一刻，留给重要的事。" Foreground="{StaticResource Text}" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="选一件小事，开始一段完整的专注。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
   <ScrollViewer x:Name="PageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,12,0">
     <StackPanel x:Name="PlanetPage">
      <Border Background="#101C32" CornerRadius="18" BorderBrush="#2E405B" BorderThickness="1"><StackPanel>
       <Grid Margin="22,18,22,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="YOUR LITTLE UNIVERSE" Foreground="#9BB5E8" FontFamily="Consolas" FontSize="11"/><TextBlock x:Name="PlanetNameText" Text="我的小星球" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="PlanetLevelText" Text="初生星球" Foreground="{StaticResource Green}" Margin="0,7,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="PlanetClockText" FontFamily="Consolas" FontSize="23" HorizontalAlignment="Right"/><TextBlock x:Name="PlanetWeatherText" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" Margin="0,5,0,0"/><Button Content="去专注  →" Click="ShowFocus" Style="{StaticResource Primary}" Margin="0,12,0,0" Padding="16,8"/></StackPanel>
       </Grid>
       <DockPanel Margin="22,4,18,0"><WrapPanel DockPanel.Dock="Right"><Button Content="展开布置" Click="ExpandPlanetEditor" Padding="12,7" FontSize="12"/><Button Content="展开观景  ⤢" Click="ExpandPlanetView" Padding="12,7" FontSize="12" Margin="0"/></WrapPanel><TextBlock Text="切换地表近景，走近你的星球" Foreground="#B8CAE5" FontSize="12" VerticalAlignment="Center"/></DockPanel>
       <ContentControl x:Name="PlanetSceneHost" Height="650" Margin="1,0"/>
       <StackPanel Margin="22,4,22,20"><TextBlock x:Name="PlanetNextText" Foreground="#DCE8F8" FontSize="13"/><ProgressBar x:Name="PlanetGrowthProgress" Height="6" Foreground="{StaticResource Green}" Background="#2C3D57" BorderThickness="0" Margin="0,10,0,10"/><DockPanel><TextBlock x:Name="PlanetGrowthText" Foreground="{StaticResource Green}" DockPanel.Dock="Right"/><TextBlock x:Name="PlanetCycleText" Foreground="{StaticResource Muted}" FontSize="12"/></DockPanel><TextBlock x:Name="PlanetFocusStatus" Foreground="#ABC9FC" FontSize="12" Margin="0,9,0,0"/></StackPanel>
      </StackPanel></Border>
      <Border x:Name="PlanetLayoutCard" Background="{StaticResource Card}" CornerRadius="14" Padding="20,18" Margin="0,16,0,0"><StackPanel>
       <DockPanel><CheckBox x:Name="PlanetEditCheck" DockPanel.Dock="Right" Content="开启布局模式" Margin="10,0,0,0" Click="TogglePlanetEdit"/><TextBlock Text="布置我的家园" FontSize="19" FontWeight="SemiBold"/></DockPanel>
       <TextBlock Text="选择已解锁的建筑、景观或生物，搭配自己的家园。开启布局后点击地块放置或选中，移动时再点击目标地块。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,12"/>
       <WrapPanel><ComboBox x:Name="PlanetBuildingChoice" Width="220" Margin="0,0,10,8" SelectionChanged="PlanetBuildingChoiceChanged"/><Button x:Name="PlanetPlaceButton" Content="选择内容并放置" Click="StartPlanetPlacement" Padding="12,8" Margin="0,0,10,8"/><Button x:Name="PlanetMoveButton" Content="移动选中内容" Click="MovePlanetBuilding" Padding="12,8" Margin="0,0,10,8"/><Button x:Name="PlanetRotateButton" Content="旋转 90°" Click="RotatePlanetBuilding" Padding="12,8" Margin="0,0,10,8"/><Button x:Name="PlanetRemoveButton" Content="收起" Click="RemovePlanetBuilding" Padding="12,8" Margin="0,0,0,8"/></WrapPanel>
       <TextBlock x:Name="PlanetLayoutHint" Foreground="{StaticResource Green}" FontSize="12" TextWrapping="Wrap" Text="布局保存在本机。已解锁内容可重复调整，不消耗成长值；每颗星球最多放置 12 只生物。"/>
      </StackPanel></Border>
      <Border Background="{StaticResource Card}" CornerRadius="14" Padding="20,18" Margin="0,16,0,0"><StackPanel>
       <TextBlock Text="今天的成长助力" FontSize="19" FontWeight="SemiBold"/>
       <UniformGrid Columns="3" Margin="0,15,0,12"><StackPanel><TextBlock Text="专注 · 每日上限 120" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="PlanetFocusPointsText" Text="+0" FontSize="28" Foreground="#A6E3BA" Margin="0,5,0,0"/><TextBlock x:Name="PlanetFocusDetailText" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel><StackPanel><TextBlock Text="Token · 每日上限 60" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="PlanetTokenPointsText" Text="+0" FontSize="28" Foreground="#A9C6FA" Margin="0,5,0,0"/><TextBlock x:Name="PlanetTokenDetailText" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel><StackPanel><TextBlock Text="共同助力 · 每日上限 20" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="PlanetSynergyPointsText" Text="+0" FontSize="28" Foreground="#EACB94" Margin="0,5,0,0"/><TextBlock x:Name="PlanetTodayGrowthText" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></UniformGrid>
       <TextBlock Text="每专注 1 分钟获得 1 点；Token 助力逐渐递减，10 万 Token 约 15 点。两者都使用时，额外获得共同助力。记录从星球启用后开始，历史数据仍保留在统计页。" Foreground="{StaticResource Muted}" FontSize="12"/>
       <Expander Header="查看成长规则和六个月路线" Foreground="{StaticResource Muted}" Margin="0,12,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="每日成长 = 专注点 + Token 点 + 共同助力，合计最多 200 点。&#10;专注点 = min(120, 向下取整(专注秒数 / 60))&#10;Token 点 = min(60, 向下取整(15 × log₂(1 + Token / 100000)))&#10;共同助力 = min(20, 向下取整(min(专注点 / 3, Token 点)))" FontSize="12"/><TextBlock x:Name="PlanetRoadmapText" Margin="0,10,0,0" FontSize="12"/><TextBlock Text="Token 包含缓存输入，只是养成助力，不代表费用、学习质量或账号额度。休息和中断不扣成长；六个自然月后可开拓下一颗星球，已有家园永久保留。" Margin="0,10,0,0" FontSize="12"/></StackPanel></Expander>
      </StackPanel></Border>
      <Border Background="{StaticResource Card}" CornerRadius="14" Padding="20,18" Margin="0,16,0,0"><StackPanel>
       <TextBlock Text="星球档案" FontSize="19" FontWeight="SemiBold"/>
       <WrapPanel Margin="0,14,0,0"><TextBox x:Name="PlanetNameInput" MaxLength="20" Width="200" Margin="0,0,10,10"/><Button Content="保存名字" Click="RenamePlanet" Margin="0,0,10,10"/><ComboBox x:Name="PlanetSelector" Width="220" Margin="0,0,10,10"/><Button Content="前往" Click="SelectPlanet" Margin="0,0,0,10"/></WrapPanel>
       <WrapPanel><Button x:Name="ExplorePlanetButton" Content="开拓新星球  ↗" Click="ExplorePlanet" Style="{StaticResource Primary}"/><TextBlock x:Name="PlanetExploreHint" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/></WrapPanel>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="FocusPage" Visibility="Collapsed">
      <Border Background="{StaticResource Card}" CornerRadius="16"><StackPanel>
       <Border x:Name="FocusHero" Background="{StaticResource Card}" CornerRadius="16,16,0,0"><Border Background="#CC102027" CornerRadius="16,16,0,0" Padding="24,18,24,16"><StackPanel>
        <DockPanel><StackPanel DockPanel.Dock="Right"><TextBlock x:Name="CurrentTimeText" Text="现在  --:--:--" Foreground="#F2F6F5" FontSize="18" TextAlignment="Right"/><TextBlock x:Name="CurrentDateText" Foreground="#D0DDDF" FontSize="11" TextAlignment="Right" Margin="0,4,0,0"/></StackPanel><StackPanel><TextBlock x:Name="SessionLabel" Text="准备好，从一个番茄开始" Foreground="{StaticResource Green}" FontSize="14"/><TextBlock Text="本轮倒计时" Foreground="#D0DDDF" FontSize="11" Margin="0,5,0,0"/></StackPanel></DockPanel>
        <TextBlock x:Name="TimerText" Text="25:00" Foreground="#F5F8F7" FontFamily="Consolas" FontSize="76" HorizontalAlignment="Center" Margin="0,4,0,4"/>
        <ProgressBar x:Name="TimerProgress" Height="4" Maximum="1" Foreground="{StaticResource Green}" Background="#41585F" BorderThickness="0" Margin="45,0,45,0"/>
       </StackPanel></Border></Border>
       <StackPanel Margin="24,16,24,18">
       <TextBlock Text="这次想完成什么？" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
       <TextBox x:Name="TaskInput" Text="" MaxLength="120" ToolTip="例如：读完一节教材，整理三条笔记"/>
       <StackPanel x:Name="SetupPanel" Margin="0,12,0,0">
        <StackPanel Orientation="Horizontal"><TextBlock Text="专注" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="FocusMinutesInput" Text="25" Width="60" MaxLength="3"/><TextBlock Text="分钟" VerticalAlignment="Center" Margin="8,0,24,0"/><TextBlock Text="休息" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="BreakMinutesInput" Text="5" Width="60" MaxLength="2"/><TextBlock Text="分钟" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
        <CheckBox x:Name="ImmersiveCheck" Content="全屏沉浸（当前屏幕）；取消勾选使用工作模式" IsChecked="True"/>
       </StackPanel>
       <WrapPanel Margin="0,10,0,0"><Button x:Name="StartButton" Content="开始专注  →" Style="{StaticResource Primary}" Click="StartFocus"/><Button x:Name="EmergencyButton" Content="紧急退出" Click="EmergencyClick" Visibility="Collapsed"/><Button x:Name="FullscreenButton" Content="进入全屏" Click="EnterFullscreenClick" Visibility="Collapsed"/><Button x:Name="BreakButton" Content="休息一下" Click="StartBreak"/><Button x:Name="TestButton" Content="10 秒验收" Click="StartTest" Visibility="Collapsed"/></WrapPanel>
       <DockPanel Margin="0,12,0,0"><WrapPanel DockPanel.Dock="Right"><Button x:Name="ChooseBackgroundButton" Content="选择背景图片" Click="ChooseBackground" Padding="12,7" FontSize="12"/><Button x:Name="ResetBackgroundButton" Content="恢复纯色" Click="ResetBackground" Padding="12,7" FontSize="12" Margin="0"/></WrapPanel><TextBlock x:Name="BackgroundHint" Text="背景：纯色 · 主页与全屏同步" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DockPanel>
       </StackPanel>
      </StackPanel></Border>
      <Border x:Name="UsageCard" Background="{StaticResource Card}" CornerRadius="14" Padding="20,18" Margin="0,16,0,0"><StackPanel>
       <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" Padding="10,4" Click="PreviousUsageDay"/><TextBlock x:Name="UsageDateLabel" VerticalAlignment="Center"/><Button Content="›" Padding="10,4" Margin="10,0,10,0" Click="NextUsageDay"/><Button Content="今天" Padding="10,4" Margin="0" Click="UsageToday"/></StackPanel><TextBlock Text="应用使用时长" FontSize="19" FontWeight="SemiBold"/></DockPanel>
       <DockPanel Margin="0,12,0,10"><CheckBox x:Name="UsageEnabledCheck" Content="记录前台应用时长" DockPanel.Dock="Right" Margin="12,0,0,0" Click="ToggleUsage"/><TextBlock x:Name="UsageSummary" Text="正在开始记录…" Foreground="{StaticResource Green}" FontSize="16"/></DockPanel>
       <StackPanel x:Name="UsageRows"/>
       <TextBlock x:Name="UsageStatusText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
       <TextBlock Text="仅在本程序运行时统计前台应用；锁屏、休眠或 60 秒无操作时暂停。只保存进程名与时长，不记录窗口标题、网页或输入内容。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
      </StackPanel></Border>
      <Border Background="{StaticResource Card}" CornerRadius="14" Padding="20,16" Margin="0,16,0,0"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" Padding="10,4" Click="PreviousYear"/><TextBlock x:Name="YearLabel" VerticalAlignment="Center"/><Button Content="›" Padding="10,4" Margin="10,0,0,0" Click="NextYear"/></StackPanel><TextBlock Text="我的年度专注" FontSize="18" FontWeight="SemiBold"/></DockPanel><TextBlock x:Name="YearSummary" Foreground="{StaticResource Muted}" Margin="0,6,0,8"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><Grid x:Name="Heatmap" Height="154"/></ScrollViewer><TextBlock Text="浅 → 深：0 / &lt;25 / 25–49 / 50–99 / ≥100 分钟 · 悬停查看日期与时长" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/><TextBlock Text="按实际专注时长累计，含提前结束；休息不计入。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border>
      <Border x:Name="TokenCard" Background="#101C20" BorderBrush="#30433F" BorderThickness="1" CornerRadius="14" Padding="20,18" Margin="0,16,0,0"><StackPanel>
       <DockPanel><StackPanel x:Name="TokenYearNavigation" DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="‹" Padding="10,4" Click="PreviousTokenYear"/><TextBlock x:Name="TokenYearLabel" VerticalAlignment="Center"/><Button Content="›" Padding="10,4" Margin="10,0,0,0" Click="NextTokenYear"/></StackPanel><StackPanel><TextBlock Text="CODEX  /  TOKEN LANDSCAPE" FontFamily="Consolas" Foreground="{StaticResource Green}" FontSize="11"/><TextBlock Text="你的年度 Token 立体日历" FontSize="23" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></DockPanel>
       <UniformGrid Columns="3" Margin="0,20,0,6"><StackPanel><TextBlock Text="所选年累计 Token" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="TokenYearTotal" Text="—" FontSize="25" Margin="0,6,0,0"/></StackPanel><StackPanel><TextBlock Text="今日 Token" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="TokenTodayTotal" Text="—" FontSize="25" Margin="0,6,0,0"/></StackPanel><StackPanel><TextBlock Text="所选年有记录天数" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="TokenDays" Text="—" FontSize="25" Margin="0,6,0,0"/></StackPanel></UniformGrid>
       <ContentControl x:Name="TokenCalendarHost" Height="510" Margin="0,6,0,12"/>
       <WrapPanel><Button x:Name="RefreshTokensButton" Content="刷新本机用量" Style="{StaticResource Primary}" Click="RefreshTokensClick" Padding="14,9"/><Button x:Name="ChooseCodexFolderButton" Content="选择 Codex 数据目录" Click="ChooseCodexFolder" Padding="14,9"/><Button x:Name="CancelTokensButton" Content="取消读取" Click="CancelTokens" Padding="14,9" Visibility="Collapsed"/></WrapPanel>
       <CheckBox x:Name="AutoRefreshTokensCheck" Content="每 2 分钟自动刷新（仅本程序运行时）" Click="ToggleTokenRefresh" FontSize="12"/>
       <TextBlock x:Name="TokenStatusText" Foreground="{StaticResource Green}" FontSize="12" Margin="0,12,0,0"/>
       <TextBlock x:Name="CodexSourceText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
       <TextBlock Text="本机日志中可读取、去重后的 Token 估算，包含缓存输入；不是账号余额、额度百分比或账单。灰格表示无本机记录，不代表当天没有使用。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/>
      </StackPanel></Border>
      <StackPanel Margin="4,14,4,0"><TextBlock x:Name="HotkeyHint" Text="紧急快捷键：Ctrl + Alt + Esc" Foreground="{StaticResource Green}" FontSize="12"/><TextBlock Text="应用限制不关闭文件；网站扩展仅拦截新访问。紧急退出可解除限制。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
     </StackPanel>
     <StackPanel x:Name="StatsPage" Visibility="Collapsed">
      <UniformGrid Columns="3" Margin="0,0,0,20"><Border Background="{StaticResource Card}" CornerRadius="12" Margin="0,0,10,0" Padding="18"><StackPanel><TextBlock Text="今日专注" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TodayStat" Text="0 分钟" FontSize="27" Margin="0,10,0,0"/></StackPanel></Border><Border Background="{StaticResource Card}" CornerRadius="12" Margin="0,0,10,0" Padding="18"><StackPanel><TextBlock Text="所选年完成番茄" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CompletedStat" Text="0" FontSize="27" Margin="0,10,0,0"/></StackPanel></Border><Border Background="{StaticResource Card}" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="所选年专注天数" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DaysStat" Text="0 天" FontSize="27" Margin="0,10,0,0"/></StackPanel></Border></UniformGrid>
      <TextBlock x:Name="StatsYearSummary" Foreground="{StaticResource Muted}" Text="年度热力图已移到番茄钟主页，可在主页切换统计年份。"/>
      <DockPanel Margin="0,22,0,12"><Button Content="导出 CSV" DockPanel.Dock="Right" Click="ExportCsv" Padding="14,7"/><TextBlock Text="最近的专注记录" FontSize="18" VerticalAlignment="Center"/></DockPanel>
      <StackPanel x:Name="HistoryPanel"/>
     </StackPanel>
     <StackPanel x:Name="RulesPage" Visibility="Collapsed">
      <Border Background="{StaticResource Card}" CornerRadius="14" Padding="24"><StackPanel>
       <TextBlock Text="应用限制" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="每行一个进程名，例如 notepad.exe。专注时切换到它会被最小化；不会关闭文件。" Foreground="{StaticResource Muted}" Margin="0,8,0,12" FontSize="12"/>
       <TextBox x:Name="AppsInput" Height="84" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
       <WrapPanel Margin="0,10,0,18"><ComboBox x:Name="RunningApps" Width="230" Margin="0,0,10,0"/><Button Content="刷新运行列表" Click="RefreshApps" Padding="12,7"/><Button Content="加入列表" Click="AddApp" Padding="12,7"/></WrapPanel>
       <TextBlock Text="网站新访问限制" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="每行一个域名，例如 bilibili.com；包含子域。需要下方浏览器扩展，已打开的页面不会自动关闭或停止播放。" Foreground="{StaticResource Muted}" Margin="0,8,0,12" FontSize="12"/>
       <TextBox x:Name="DomainsInput" Height="84" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
       <Button Content="保存限制设置" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="SaveRules" Margin="0,16,0,0"/>
      </StackPanel></Border>
      <Border BorderBrush="#2C4045" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,18,0,0"><StackPanel><TextBlock Text="连接 Edge / Chrome 扩展" FontSize="18"/><TextBlock Text="在浏览器扩展页加载交付包内的 browser-extension 文件夹，然后在扩展弹窗粘贴配对码。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12"/><WrapPanel><Button Content="复制配对码" Click="CopyToken" Padding="14,8"/><Button Content="打开扩展文件夹" Click="OpenExtensionFolder" Padding="14,8"/></WrapPanel><TextBlock x:Name="ApiStatus" Foreground="{StaticResource Green}" FontSize="12" Margin="0,12,0,0"/><TextBlock Text="桌面退出或断联后，扩展在下次唤醒同步时解除；若浏览器挂起，可禁用扩展立即恢复。应用限制无法拦截管理员窗口或改名后的程序。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <TextBlock Grid.Row="2" x:Name="StatusText" Text="就绪 · 所有记录仅保存在本机" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/>
  </Grid>
 </Grid>
</Window>

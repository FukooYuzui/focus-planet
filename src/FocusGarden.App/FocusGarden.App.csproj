<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>FocusGarden</AssemblyName>
    <Version>0.7.3</Version><Product>专注星球</Product><Title>专注星球</Title><Description>用专注与探索，养成自己的小星球。</Description><ApplicationManifest>app.manifest</ApplicationManifest><RuntimeFrameworkVersion>8.0.22</RuntimeFrameworkVersion>
    <ApplicationIcon>Assets/FocusPlanet.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../FocusGarden.Core/FocusGarden.Core.csproj"/><ProjectReference Include="../FocusGarden.Timing/FocusGarden.Timing.csproj"/></ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/FocusPlanet-256.png" />
    <EmbeddedResource Include="../../browser-extension/background.js" LogicalName="FocusGarden.BrowserExtension.background.js" />
    <EmbeddedResource Include="../../browser-extension/controller.js" LogicalName="FocusGarden.BrowserExtension.controller.js" />
    <EmbeddedResource Include="../../browser-extension/manifest.json" LogicalName="FocusGarden.BrowserExtension.manifest.json" />
    <EmbeddedResource Include="../../browser-extension/popup.css" LogicalName="FocusGarden.BrowserExtension.popup.css" />
    <EmbeddedResource Include="../../browser-extension/popup.html" LogicalName="FocusGarden.BrowserExtension.popup.html" />
    <EmbeddedResource Include="../../browser-extension/popup.js" LogicalName="FocusGarden.BrowserExtension.popup.js" />
    <EmbeddedResource Include="../../browser-extension/rules.js" LogicalName="FocusGarden.BrowserExtension.rules.js" />
    <EmbeddedResource Include="../../browser-extension/README.md" LogicalName="FocusGarden.BrowserExtension.README.md" />
  </ItemGroup>
</Project>
